名称: 阴阳寮晚间活动
分类: guild
优先级: 16
说明: 统一涵盖阴阳寮神社晚间全部 6 项集体活动：道馆突破、狩猎战·麒麟、阴界之门、狭间暗域（神龙/孔雀/白藏主/黑豹四域）、首领退治与寮宴会挂机

设置: [
  {
    "id": "soulPreset",
    "label": "开战前自动切换御魂预设",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "御魂预设",
    "description": "开战前自动前往庭院式神录→预设面板，一键装配指定分组与队伍的御魂预设",
    "recommended": "none",
    "options": [
      {"value": "none", "label": "不切换（保持当前身上御魂）"},
      {"value": "1-1", "label": "分组 1 · 队伍 1"},
      {"value": "1-2", "label": "分组 1 · 队伍 2"},
      {"value": "1-3", "label": "分组 1 · 队伍 3"},
      {"value": "1-4", "label": "分组 1 · 队伍 4"},
      {"value": "2-1", "label": "分组 2 · 队伍 1"},
      {"value": "2-2", "label": "分组 2 · 队伍 2"},
      {"value": "2-3", "label": "分组 2 · 队伍 3"},
      {"value": "2-4", "label": "分组 2 · 队伍 4"},
      {"value": "3-1", "label": "分组 3 · 队伍 1"},
      {"value": "3-2", "label": "分组 3 · 队伍 2"},
      {"value": "3-3", "label": "分组 3 · 队伍 3"},
      {"value": "3-4", "label": "分组 3 · 队伍 4"},
      {"value": "4-1", "label": "分组 4 · 队伍 1"},
      {"value": "4-2", "label": "分组 4 · 队伍 2"},
      {"value": "4-3", "label": "分组 4 · 队伍 3"},
      {"value": "4-4", "label": "分组 4 · 队伍 4"},
      {"value": "5-1", "label": "分组 5 · 队伍 1"},
      {"value": "5-2", "label": "分组 5 · 队伍 2"},
      {"value": "5-3", "label": "分组 5 · 队伍 3"},
      {"value": "5-4", "label": "分组 5 · 队伍 4"},
      {"value": "6-1", "label": "分组 6 · 队伍 1"},
      {"value": "6-2", "label": "分组 6 · 队伍 2"},
      {"value": "6-3", "label": "分组 6 · 队伍 3"},
      {"value": "6-4", "label": "分组 6 · 队伍 4"},
      {"value": "7-1", "label": "分组 7 · 队伍 1"},
      {"value": "7-2", "label": "分组 7 · 队伍 2"},
      {"value": "7-3", "label": "分组 7 · 队伍 3"},
      {"value": "7-4", "label": "分组 7 · 队伍 4"}
    ]
  },
  {
    "id": "activity",
    "label": "晚间寮活动类型",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "阴阳寮神社",
    "description": "选择进入阴阳寮神社后要参与的晚间集体活动",
    "recommended": "dokan",
    "options": [
      {"value": "dokan", "label": "道馆突破（自动集结与连续攻打馆主）"},
      {"value": "kirin", "label": "狩猎战 · 麒麟（周一至周四 19:00）"},
      {"value": "twilight", "label": "狩猎战 · 阴界之门 70 层（周五至周日 19:00）"},
      {"value": "abyss", "label": "狭间暗域（神龙/孔雀/白藏主/黑豹自动寻敌）"},
      {"value": "retreat", "label": "首领退治（周六晚间三轮首领挑战与领箱）"},
      {"value": "banquet", "label": "阴阳寮宴会（自动入席吃料理领经验与烟花）"}
    ]
  },
  {
    "id": "returnHome",
    "label": "完成后返回庭院",
    "widget": "SWITCH",
    "section": "收尾",
    "description": "寮活动结束后自动退回庭院",
    "recommended": true
  }
]

=== switch-soul: 自动前往式神录切换御魂预设 ===
[条件] soulPreset != "none"
[超时] 90000ms
[片段] switch-soul-preset

=== enter-shrine: 前往阴阳寮并打开神社 ===

去 阴阳寮
如果看到 "神社"@右:1640,860,165,210 最多 5秒
  点 "神社"@右:1640,860,165,210 整行 偏 -40,-75 大小 80,70
等 "神社"@左上标题 或 "道馆"@神社列表区 或 "狩猎战"@神社列表区 或 页 guild 最多 10秒

=== run-guild-activity: 按设定进入对应晚间寮活动并作战 ===
[超时] 300000ms

长等待 300秒
按设置 activity
  "dokan"
    如果看到 "道馆"@神社列表区 最多 5秒
      点 "道馆"@神社列表区
    如果看到 "道馆突破"@顶部居中标题 最多 8秒
      点 "挑战"@右下挑战区 最多 15秒
      用 battle-auto-loop
  "kirin"
    如果看到 "狩猎战"@神社列表区 最多 5秒
      点 "狩猎战"@神社列表区
    如果看到 "挑战"@右下挑战区 最多 8秒
      点 "挑战"@右下挑战区
      用 battle-auto-loop
  "twilight"
    如果看到 "阴界之门"@神社列表区 最多 5秒
      点 "阴界之门"@神社列表区
    如果看到 "挑战"@400,760,1900,280 最多 8秒
      点 "挑战"@400,760,1900,280
      如果看到 "确定"@弹窗确认右侧 最多 5秒
        点 "确定"@弹窗确认右侧
      如果看到 "挑战"@右下挑战区 最多 6秒
        点 "挑战"@右下挑战区
      用 battle-auto-loop
  "abyss"
    如果看到 "狭间暗域"@神社列表区 最多 5秒
      点 "狭间暗域"@神社列表区
      如果看到 "神龙"@神社列表区 最多 5秒
        点 "神龙"@神社列表区
      如果看到 "战报"@左:0,20,360,260 最多 6秒
        点 "战报"@左:0,20,360,260
        如果看到 "前往"@弹窗按钮区 最多 5秒
          点 "前往"@弹窗按钮区
          如果看到 "挑战"@右下挑战区 最多 8秒
            点 "挑战"@右下挑战区
            用 battle-auto-loop
  "retreat"
    如果看到 "首领退治"@神社列表区 最多 5秒
      点 "首领退治"@神社列表区
    如果看到 "挑战"@右下挑战区 最多 8秒
      点 "挑战"@右下挑战区
      用 battle-auto-loop
  "banquet"
    如果看到 "宴会"@神社列表区 最多 5秒
      点 "宴会"@神社列表区
      反复 最多 6 次
        等待 5秒
        如果看到 "获得奖励"@获得奖励标题 最多 4.5秒
          点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
等 页 guild 或 页 courtyard 最多 15秒
结果 "已完成阴阳寮晚间集体活动"

=== return-courtyard: 回到庭院 ===
[条件] returnHome = true
[片段] exit-subpage-courtyard
