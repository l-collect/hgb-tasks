=== foster: 寄养式神 ===

# 寄养式神：自己的寄养位空着，就按设置在好友里挑卡，进好友结界把式神拖进空位
用 realm-go
如果看到 图 realm-training@1000,330,320,400 0.8
  直到 "式神育成"@180,20,340,110 最多 4 次           # 式神走过会挡住育成旗，挡住就再点
    点 图 realm-back@100,0,220,130 最上 偏 941,349 大小 50,50
  分情况 最多 10秒
    寄养中 "式神育成"@180,20,340,110 且 没有 "进入好友结界寄养式神"@1300,140,520,90 且 没有 图 foster-plus@1900,40,240,200
      结果 "式神还在寄养中"
    空着 "式神育成"@180,20,340,110 且 图 foster-plus@1900,40,240,200 且 没有 "进入好友结界寄养式神"@1300,140,520,90
      点 图 foster-plus@1900,40,240,200 最上
      等 "进入好友结界寄养式神"@1300,140,520,90
      反复 最多 1 次                                   # 挑卡：按偏好的卡种顺序，逐个看好友列表前 4 行
        按设置 fosterCard
          jade
            逐个 卡 在 太鼓,斗鱼,伞室
              逐个 行 在 96,258,420,582
                点 "进入好友结界寄养式神"@1300,140,520,90 偏 -717,{行}
                分情况 最多 6秒
                  有卡 "{卡}"@1420,515,280,80 且 "进入结界"@1400,800,320,100
                    结果 "挑了好友的{卡}卡"
                    点 "进入结界"@1400,800,320,100
                    跳出
                  没这种卡 "进入好友结界寄养式神"@1300,140,520,90 且 没有 "{卡}"@1420,515,280,80
          stamina
            逐个 卡 在 斗鱼,太鼓,伞室
              逐个 行 在 96,258,420,582
                点 "进入好友结界寄养式神"@1300,140,520,90 偏 -717,{行}
                分情况 最多 6秒
                  有卡 "{卡}"@1420,515,280,80 且 "进入结界"@1400,800,320,100
                    结果 "挑了好友的{卡}卡"
                    点 "进入结界"@1400,800,320,100
                    跳出
                  没这种卡 "进入好友结界寄养式神"@1300,140,520,90 且 没有 "{卡}"@1420,515,280,80
          exp
            逐个 卡 在 伞室,斗鱼,太鼓
              逐个 行 在 96,258,420,582
                点 "进入好友结界寄养式神"@1300,140,520,90 偏 -717,{行}
                分情况 最多 6秒
                  有卡 "{卡}"@1420,515,280,80 且 "进入结界"@1400,800,320,100
                    结果 "挑了好友的{卡}卡"
                    点 "进入结界"@1400,800,320,100
                    跳出
                  没这种卡 "进入好友结界寄养式神"@1300,140,520,90 且 没有 "{卡}"@1420,515,280,80
        结果 "好友里没有可寄养的结界卡"
        点 "进入好友结界寄养式神"@1300,140,520,90 偏 579,306   # 关列表
      分情况 最多 15秒
        自己结界 "式神育成"@180,20,340,110 且 图 foster-plus@1900,40,240,200 且 没有 "进入好友结界寄养式神"@1300,140,520,90
        好友结界 "式神育成"@180,20,340,110 且 没有 "确定"@1220,770,260,100 且 没有 "进入好友结界寄养式神"@1300,140,520,90 且 没有 图 foster-plus@1900,40,240,200
          反复 最多 1 次                                 # 放式神：从左数第 1 张起，满级和达摩跳过
            逐个 i 在 0,1,2,3,4,5,6,7
              分情况 最多 8秒
                满了 "式神育成"@180,20,340,110 且 没有 "确定"@1220,770,260,100 且 没有 图 foster-free@1710,50,140,170 且 没有 图 foster-free@1940,50,150,170
                  结果 "好友结界的寄养位已满，没有寄养"
                  跳出
                有空位 "式神育成"@180,20,340,110 且 图 foster-free@1940,50,150,170 且 没有 "确定"@1220,770,260,100
                有空位 "式神育成"@180,20,340,110 且 图 foster-free@1710,50,140,170 且 没有 "确定"@1220,770,260,100 且 没有 图 foster-free@1940,50,150,170
              分情况 最多 4秒                             # 第 {i+1} 张卡能不能放
                不放 "式神育成"@180,20,340,110 且 "满"@{323+202*i},700,90,75 整行
                不放 "式神育成"@180,20,340,110 且 图 daruma-white@{363+202*i},740,150,140 且 没有 "满"@{323+202*i},700,90,75 整行
                不放 "式神育成"@180,20,340,110 且 图 daruma-blue@{363+202*i},740,150,140 且 没有 "满"@{323+202*i},700,90,75 整行 且 没有 图 daruma-white@{363+202*i},740,150,140
                不放 "式神育成"@180,20,340,110 且 图 daruma-red@{363+202*i},740,150,140 且 没有 "满"@{323+202*i},700,90,75 整行 且 没有 图 daruma-white@{363+202*i},740,150,140 且 没有 图 daruma-blue@{363+202*i},740,150,140
                能放 "式神育成"@180,20,340,110 且 没有 "满"@{323+202*i},700,90,75 整行 且 没有 图 daruma-white@{363+202*i},740,150,140 且 没有 图 daruma-blue@{363+202*i},740,150,140 且 没有 图 daruma-red@{363+202*i},740,150,140
                  分情况 最多 4秒
                    右边空 "式神育成"@180,20,340,110 且 图 foster-free@1940,50,150,170
                      拖 "式神育成"@180,20,340,110 偏 {66+202*i},712 到 {1578-202*i},-708
                    左边空 "式神育成"@180,20,340,110 且 图 foster-free@1710,50,140,170 且 没有 图 foster-free@1940,50,150,170
                      拖 "式神育成"@180,20,340,110 偏 {66+202*i},712 到 {1326-202*i},-708
                  等 "确定"@1220,770,260,100 且 "取消"@940,770,240,100
                  点 "确定"@1220,770,260,100
                  等 "式神育成"@180,20,340,110 且 没有 "确定"@1220,770,260,100
                  结果 "已寄养式神"
                  跳出
            结果 "没有能寄养的式神"
  反复 最多 4 次
    分情况 最多 10秒
      到结界 图 realm-back@100,0,220,130 且 没看到 "式神育成"@180,20,340,110 且 没看到 "进入好友结界寄养式神"@1300,140,520,90
        跳出
      好友列表 "进入好友结界寄养式神"@1300,140,520,90
        点 "进入好友结界寄养式神"@1300,140,520,90 偏 579,306
      育成页 "式神育成"@180,20,340,110 且 没看到 "进入好友结界寄养式神"@1300,140,520,90
        点 图 page-back@60,0,240,180
等 页 realm 或 页 courtyard 最多 15秒

=== replace-maxed: 更换满级式神 ===
[条件] replaceMaxed = true

# 更换满级式神：结界育成页点“智能放入”，育成位一下全换成 1 级白达摩
用 realm-go
如果看到 图 realm-training@1000,330,320,400 0.8              # 进到了自己的结界才做
  直到 "式神育成"@180,20,340,110 最多 4 次           # 式神走过会挡住育成旗，挡住就再点
    点 图 realm-back@100,0,220,130 最上 偏 941,349 大小 50,50
  等 "式神育成"@180,20,340,110 且 没有 "进入好友结界寄养式神"@1300,140,520,90
  如果有 "智能"@2060,720,180,130
    点 "智能"@2060,720,180,130
    等 "式神育成"@180,20,340,110 且 "卸下"@2060,720,180,130
    结果 "育成位换上了 1 级白达摩"
等 "式神育成"@180,20,340,110 或 图 realm-back@100,0,220,130 或 "探索"@800,100,700,320      # 育成页、结界或（没进去时）庭院

=== realm-rewards: 收取结界奖励 ===
[条件] collectRealm = true

# 收取结界奖励：结界经验、体力食盒、经验酒壶，有气泡才领
用 realm-go
如果看到 图 realm-training@1000,330,320,400 0.8              # 进到了自己的结界才做
  等 图 realm-back@100,0,220,130 且 图 realm-training@1000,330,320,400 0.8 且 没有 "寮信息"@2040,990,280,90
  如果有 "EXP"@1060,170,200,160 整行
    点 "EXP"@1060,170,200,160 整行
    等 "获得奖励"@900,260,600,200
    点 "获得奖励"@900,260,600,200 偏 1000,530
    结果 "领了结界经验"
  等 图 realm-back@100,0,220,130 且 图 realm-training@1000,330,320,400 0.8 且 没有 "寮信息"@2040,990,280,90
  如果有 图 realm-food-bubble@1380,560,320,240
    点 图 realm-food-bubble@1380,560,320,240
    等 "体力食盒"@1000,110,450,140
    点 "取出"@1050,760,300,130
    等 "获得奖励"@900,260,600,200
    点 "获得奖励"@900,260,600,200 偏 1000,530
    等 "体力食盒"@1000,110,450,140
    点 "当前存储"@950,250,350,100 偏 598,-56          # 关食盒
    结果 "取出了体力食盒里的体力"
  等 图 realm-back@100,0,220,130 且 图 realm-training@1000,330,320,400 0.8 且 没有 "寮信息"@2040,990,280,90
  如果有 图 realm-jar-bubble@1480,580,280,200
    点 图 realm-jar-bubble@1480,580,280,200
    等 "经验酒壶"@1000,110,450,140
    点 "提取"@1080,660,240,130
    如果看到 "经验酒壶"@1000,110,450,140          # 提取后面板会自己淡出，稳定 1 秒还在才算没提取
      点 "当前存储"@950,250,350,100 偏 598,-56
      结果 "经验酒壶没能提取"
    否则
      结果 "提取了经验酒壶里的经验"
等 图 realm-back@100,0,220,130 或 "探索"@800,100,700,320      # 结界或（没进去时）庭院

=== place-card: 放结界卡 ===
[条件] placeCard = true

# 放结界卡：庭院 → 阴阳寮 → 结界 → 结界卡面板 → 挑卡 → 核对灯笼 → 激活 → 回庭院
# 取消、卸下都可能吞卡：卡放进槽里还没激活时，不关面板、不点取消或卸下
用 realm-go
如果看到 图 realm-training@1000,330,320,400 0.8              # 进到了自己的结界才做
  直到 "自动邀请"@1780,720,200,90 最多 4 次          # 式神走过会挡住结界卡旗，挡住就再点
    点 图 realm-back@100,0,220,130 最上 偏 1379,389 大小 50,50
  # 到期的卡还占着槽（计时 00:00:00）：卸下结算收益、清掉它。只对到期卡这样做
  如果看到 "00:00:00"@1560,380,300,80
    点 "卸下"@1600,920,200,90
    等 "删除结界卡"@800,460,800,100 且 "确认"@1220,590,260,90
    点 "确认"@1220,590,260,90
    等 "结界卡"@1080,50,320,100 且 没有 "卸下"@1600,920,200,90
  分情况
    生效中 "结界卡"@1080,50,320,100 且 "卸下"@1600,920,200,90
      结果 "结界卡还在生效，没放新卡"
    已放未激活 "结界卡"@1080,50,320,100 且 "结界寄养"@1060,750,300,80 且 没有 "卸下"@1600,920,200,90
      用 realm-card-activate
    空槽 "结界卡"@1080,50,320,100 且 没有 "卸下"@1600,920,200,90 且 没有 "结界寄养"@1060,750,300,80
      点 "星级降序"@520,130,260,100 偏 224,-48 大小 50,50    # 筛选
      等 "特殊变异"@780,750,240,90
      按设置 cardKind
        jade
          点 "太鼓"@790,340,230,90
        stamina
          点 "斗鱼"@790,440,230,90
        exp
          点 "伞室"@790,540,230,90
      分情况
        有卡 "小时"@860,270,200,80
          点 "星级降序"@520,130,260,100 偏 124,108 大小 50,50   # 第一张卡
          用 realm-card-activate
        没卡 "结界卡"@1080,50,320,100 且 没有 "小时"@860,270,200,80
          结果 "没有这种结界卡，没放卡"
  分情况                                              # 只在卡已生效或槽空时关面板
    可关 "结界卡"@1080,50,320,100 且 "卸下"@1600,920,200,90
    可关 "结界卡"@1080,50,320,100 且 没有 "结界寄养"@1060,750,300,80
  点 "自动邀请"@1780,720,200,90 偏 100,-652 大小 50,50      # 面板右上 X
  直到 "寮信息"@2040,990,280,90 最多 4 次
    点 图 realm-back@100,0,220,130 最上
  分情况 最多 15秒                                    # 结界退出来有时直接回到庭院
    寮大厅 "寮信息"@2040,990,280,90
      点 "寮信息"@2040,990,280,90 偏 -2000,-1022     # 离开寮
    庭院 "探索"@800,100,700,320
等 "探索"@800,100,700,320 或 图 realm-back@100,0,220,130      # 退回庭院，或还在结界

=== return-courtyard: 回到庭院 ===
[片段] go-courtyard
