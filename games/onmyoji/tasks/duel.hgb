名称: 自动斗技
分类: battle
优先级: 13
说明: 从庭院经町中进入斗技大厅，统一支持“正常自动上阵作战”、“自动退场刷荣誉（拔菜）”及周末“协同斗技（大小号双人组队作战，自动唤醒小号跟车与候补式神上阵）”三种模式

设置: [
  {
    "id": "soulPreset",
    "label": "开战前自动切换御魂预设",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "御魂预设",
    "description": "开战前自动前往庭院式神录→预设面板，一键装配指定分组与队伍的御魂预设",
    "recommended": "none",
    "options": [
      {"value": "none", "label": "不切换（保持当前身上御魂）"},
      {"value": "1-1", "label": "分组 1 · 队伍 1"},
      {"value": "1-2", "label": "分组 1 · 队伍 2"},
      {"value": "1-3", "label": "分组 1 · 队伍 3"},
      {"value": "1-4", "label": "分组 1 · 队伍 4"},
      {"value": "2-1", "label": "分组 2 · 队伍 1"},
      {"value": "2-2", "label": "分组 2 · 队伍 2"},
      {"value": "2-3", "label": "分组 2 · 队伍 3"},
      {"value": "2-4", "label": "分组 2 · 队伍 4"},
      {"value": "3-1", "label": "分组 3 · 队伍 1"},
      {"value": "3-2", "label": "分组 3 · 队伍 2"},
      {"value": "3-3", "label": "分组 3 · 队伍 3"},
      {"value": "3-4", "label": "分组 3 · 队伍 4"},
      {"value": "4-1", "label": "分组 4 · 队伍 1"},
      {"value": "4-2", "label": "分组 4 · 队伍 2"},
      {"value": "4-3", "label": "分组 4 · 队伍 3"},
      {"value": "4-4", "label": "分组 4 · 队伍 4"},
      {"value": "5-1", "label": "分组 5 · 队伍 1"},
      {"value": "5-2", "label": "分组 5 · 队伍 2"},
      {"value": "5-3", "label": "分组 5 · 队伍 3"},
      {"value": "5-4", "label": "分组 5 · 队伍 4"},
      {"value": "6-1", "label": "分组 6 · 队伍 1"},
      {"value": "6-2", "label": "分组 6 · 队伍 2"},
      {"value": "6-3", "label": "分组 6 · 队伍 3"},
      {"value": "6-4", "label": "分组 6 · 队伍 4"},
      {"value": "7-1", "label": "分组 7 · 队伍 1"},
      {"value": "7-2", "label": "分组 7 · 队伍 2"},
      {"value": "7-3", "label": "分组 7 · 队伍 3"},
      {"value": "7-4", "label": "分组 7 · 队伍 4"}
    ]
  },
  {
    "id": "duelMode",
    "label": "斗技模式",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "斗技设置",
    "description": "正常自动作战适合日常冲分与首胜；退场刷荣誉适合快速拿满周荣誉；协同斗技适合周六/周日 14:00-23:00 大小号双人组队",
    "recommended": "fight",
    "options": [
      {"value": "fight", "label": "单人斗技 · 正常自动上阵作战（推荐）"},
      {"value": "concede", "label": "单人斗技 · 进入准备后自动退出刷荣誉（拔菜）"},
      {"value": "coop", "label": "协同斗技 · 双人组队作战（周六/周日 14:00-23:00）"}
    ]
  },
  {
    "id": "coopRole",
    "label": "协同斗技主次角色",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "协同斗技设置",
    "description": "主号选队长（自动建队邀小号并联动唤醒小号设备）；小号被唤醒时自动以队员身份在庭院接邀请",
    "recommended": "leader",
    "visibleWhen": {"field": "duelMode", "contains": "coop"},
    "options": [
      {"value": "leader", "label": "队长 · 主号（进入协同斗技建队 + 邀请协战小号 + 发起匹配）"},
      {"value": "member", "label": "队员 · 次号（在庭院接协同邀请 + 配合上阵准备）"}
    ]
  },
  {
    "id": "coopLineup",
    "label": "协同斗技备战上阵策略",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "协同斗技设置",
    "description": "支持锁定固定阵容直接准备，或从底部候补式神列表自动依次点选前 3 名式神上阵",
    "recommended": "autoLock",
    "visibleWhen": {"field": "duelMode", "contains": "coop"},
    "options": [
      {"value": "autoLock", "label": "锁定固定阵容 / 自动上阵直接点准备（省心速刷）"},
      {"value": "pickThree", "label": "按底部候补式神列表自动依次点选前 3 名式神上阵并准备"}
    ]
  },
  {
    "id": "partnerAccount",
    "label": "协同斗技联动小号（留空则自动使用计划或账号绑定的默认协战搭子）",
    "widget": "TEXT",
    "section": "协同斗技设置",
    "description": "可按需覆盖填写协战小号名称、游戏昵称或编号；留空则使用账号详情页绑定的 1 号默认协战搭子",
    "visibleWhen": {"field": "duelMode", "contains": "coop"}
  },
  {
    "id": "bouts",
    "label": "连续斗技场次",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "斗技设置",
    "description": "单次任务连续匹配多少场斗技或协同斗技",
    "recommended": "5",
    "options": [
      {"value": "3", "label": "3 场（每日首胜速刷）"},
      {"value": "5", "label": "5 场（推荐）"},
      {"value": "10", "label": "10 场（刷满周荣誉 / 协同周奖励）"}
    ]
  },
  {
    "id": "returnHome",
    "label": "完成后返回庭院",
    "widget": "SWITCH",
    "section": "收尾",
    "description": "斗技结束后自动经町中返回庭院",
    "recommended": true
  }
]

=== switch-soul: 自动前往式神录切换御魂预设 ===
[条件] soulPreset != "none"
[超时] 90000ms
[片段] switch-soul-preset

=== enter-duel: 经町中前往斗技或协同斗技大厅（协同队员回庭院待命） ===

按设置 duelMode
  "coop"
    按设置 coopRole
      "member"
        去 庭院
        结果 "协同斗技队员已在庭院就位，等待队长邀请"
      其他
        用 enter-duel
        如果看到 "协同斗技"@右:1760,150,600,720 最多 5秒
          点 "协同斗技"@右:1760,150,600,720
        如果看到 "创建队伍"@右下挑战区 最多 5秒
          点 "创建队伍"@右下挑战区
          如果看到 "邀请"@中:920,740,560,220 最多 5秒
            如果看到 "最近"@中:700,110,1000,120 最多 4秒
              点 "最近"@中:700,110,1000,120
            等待 1秒
            点 "邀请"@中:920,740,560,220 偏 -120,-480 大小 200,100
            点 "邀请"@中:920,740,560,220
            结果 "协同斗技队长已建队并邀请协战小号"
  其他
    用 enter-duel
等 "斗技"@左上标题 或 "协同斗技"@左上标题 或 "战"@斗技右下战斗 或 "练习"@右下挑战区 或 "匹配"@右下挑战区 或 "探索"@800,100,700,320 最多 12秒

=== auto-duel-loop: 按设定模式与场次循环匹配 ===
[超时] 300000ms

长等待 300秒
按设置 duelMode
  "fight"
    按设置 bouts
      "3"
        反复 最多 3 次
          分情况 最多 15秒
            高光分享 "取消"@弹窗按钮区
              点 "取消"@弹窗按钮区
            结算继续 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
              点 "继续"@结算底部继续 最多 2秒
            在斗技大厅 "战"@斗技右下战斗 且 没看到 "取消"@弹窗按钮区 且 没看到 "继续"@结算底部继续
              点 "战"@斗技右下战斗
              用 battle-auto-loop
      "5"
        反复 最多 5 次
          分情况 最多 15秒
            高光分享 "取消"@弹窗按钮区
              点 "取消"@弹窗按钮区
            结算继续 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
              点 "继续"@结算底部继续 最多 2秒
            在斗技大厅 "战"@斗技右下战斗 且 没看到 "取消"@弹窗按钮区 且 没看到 "继续"@结算底部继续
              点 "战"@斗技右下战斗
              用 battle-auto-loop
      "10"
        反复 最多 10 次
          分情况 最多 15秒
            高光分享 "取消"@弹窗按钮区
              点 "取消"@弹窗按钮区
            结算继续 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
              点 "继续"@结算底部继续 最多 2秒
            在斗技大厅 "战"@斗技右下战斗 且 没看到 "取消"@弹窗按钮区 且 没看到 "继续"@结算底部继续
              点 "战"@斗技右下战斗
              用 battle-auto-loop
  "concede"
    按设置 bouts
      "3"
        反复 最多 3 次
          如果看到 "战"@斗技右下战斗 最多 10秒
            点 "战"@斗技右下战斗
            # 阶段1：等进入备战阶段并点击左上退出（使用已验证的 准备页返回 色点，绝不越界或同帧双命中）
            等 色 准备页返回 最多 45秒
            点 色 准备页返回
            如果看到 "确定"@弹窗确认右侧 最多 5秒
              点 "确定"@弹窗确认右侧
            否则
              如果看到 "确认"@弹窗确认右侧 最多 4.5秒
                点 "确认"@弹窗确认右侧
            # 阶段2：点击失败结算回到斗技大厅
            反复 最多 6 次
              分情况 最多 15秒
                高光分享 "取消"@弹窗按钮区
                  点 "取消"@弹窗按钮区
                失败结算 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
                  点 "继续"@结算底部继续 最多 2秒
                已回大厅 "斗技"@左上标题 且 没看到 "取消"@弹窗按钮区 且 没看到 "继续"@结算底部继续
                  跳出
      "5"
        反复 最多 5 次
          如果看到 "战"@斗技右下战斗 最多 10秒
            点 "战"@斗技右下战斗
            等 色 准备页返回 最多 45秒
            点 色 准备页返回
            如果看到 "确定"@弹窗确认右侧 最多 5秒
              点 "确定"@弹窗确认右侧
            否则
              如果看到 "确认"@弹窗确认右侧 最多 4.5秒
                点 "确认"@弹窗确认右侧
            反复 最多 6 次
              分情况 最多 15秒
                高光分享 "取消"@弹窗按钮区
                  点 "取消"@弹窗按钮区
                失败结算 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
                  点 "继续"@结算底部继续 最多 2秒
                已回大厅 "斗技"@左上标题 且 没看到 "取消"@弹窗按钮区 且 没看到 "继续"@结算底部继续
                  跳出
      "10"
        反复 最多 10 次
          如果看到 "战"@斗技右下战斗 最多 10秒
            点 "战"@斗技右下战斗
            等 色 准备页返回 最多 45秒
            点 色 准备页返回
            如果看到 "确定"@弹窗确认右侧 最多 5秒
              点 "确定"@弹窗确认右侧
            否则
              如果看到 "确认"@弹窗确认右侧 最多 4.5秒
                点 "确认"@弹窗确认右侧
            反复 最多 6 次
              分情况 最多 15秒
                高光分享 "取消"@弹窗按钮区
                  点 "取消"@弹窗按钮区
                失败结算 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
                  点 "继续"@结算底部继续 最多 2秒
                已回大厅 "斗技"@左上标题 且 没看到 "取消"@弹窗按钮区 且 没看到 "继续"@结算底部继续
                  跳出
  "coop"
    按设置 bouts
      "3"
        反复 最多 15 次
          分情况 最多 30秒
            接协同邀请 "接受"@左:0,120,420,420 且 没看到 "准备"@战斗准备区 且 没看到 "继续"@结算底部继续
              点 "接受"@左:0,120,420,420
            默认续邀确认 "确定"@弹窗确认右侧 且 没看到 "继续"@结算底部继续
              点 "确定"@弹窗确认右侧
            高光分享 "取消"@弹窗按钮区 且 没看到 "确定"@弹窗确认右侧
              点 "取消"@弹窗按钮区
            备战选人准备 "准备"@战斗准备区 且 没看到 "手动"@战斗左下自动 且 没看到 "继续"@结算底部继续
              按设置 coopLineup
                "pickThree"
                  点 "准备"@战斗准备区 偏 -1500,120 大小 110,110
                  点 "准备"@战斗准备区 偏 -1320,120 大小 110,110
                  点 "准备"@战斗准备区 偏 -1140,120 大小 110,110
                  点 "准备"@战斗准备区
                其他
                  点 "准备"@战斗准备区
            需切自动 "手动"@战斗左下自动 且 没看到 "继续"@结算底部继续
              点 "手动"@战斗左下自动
            结算继续 "继续"@结算底部继续 且 没看到 "取消"@弹窗按钮区
              点 "继续"@结算底部继续 最多 2秒
            队长发起匹配 "战"@斗技右下战斗 且 没看到 "准备"@战斗准备区 且 没看到 "继续"@结算底部继续
              点 "战"@斗技右下战斗
      "5"
        反复 最多 25 次
          分情况 最多 30秒
            接协同邀请 "接受"@左:0,120,420,420 且 没看到 "准备"@战斗准备区 且 没看到 "继续"@结算底部继续
