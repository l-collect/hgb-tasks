名称: 版本与限时活动
分类: battle
优先级: 15
说明: 统一涵盖月度大型版本活动爬塔、对弈竞猜自动押注、夏境/花车巡游放置里程领取与超鬼王自动召唤征伐

设置: [
  {
    "id": "soulPreset",
    "label": "开战前自动切换御魂预设",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "御魂预设",
    "description": "开战前自动前往庭院式神录→预设面板，一键装配指定分组与队伍的御魂预设",
    "recommended": "none",
    "options": [
      {"value": "none", "label": "不切换（保持当前身上御魂）"},
      {"value": "1-1", "label": "分组 1 · 队伍 1"},
      {"value": "1-2", "label": "分组 1 · 队伍 2"},
      {"value": "1-3", "label": "分组 1 · 队伍 3"},
      {"value": "1-4", "label": "分组 1 · 队伍 4"},
      {"value": "2-1", "label": "分组 2 · 队伍 1"},
      {"value": "2-2", "label": "分组 2 · 队伍 2"},
      {"value": "2-3", "label": "分组 2 · 队伍 3"},
      {"value": "2-4", "label": "分组 2 · 队伍 4"},
      {"value": "3-1", "label": "分组 3 · 队伍 1"},
      {"value": "3-2", "label": "分组 3 · 队伍 2"},
      {"value": "3-3", "label": "分组 3 · 队伍 3"},
      {"value": "3-4", "label": "分组 3 · 队伍 4"},
      {"value": "4-1", "label": "分组 4 · 队伍 1"},
      {"value": "4-2", "label": "分组 4 · 队伍 2"},
      {"value": "4-3", "label": "分组 4 · 队伍 3"},
      {"value": "4-4", "label": "分组 4 · 队伍 4"},
      {"value": "5-1", "label": "分组 5 · 队伍 1"},
      {"value": "5-2", "label": "分组 5 · 队伍 2"},
      {"value": "5-3", "label": "分组 5 · 队伍 3"},
      {"value": "5-4", "label": "分组 5 · 队伍 4"},
      {"value": "6-1", "label": "分组 6 · 队伍 1"},
      {"value": "6-2", "label": "分组 6 · 队伍 2"},
      {"value": "6-3", "label": "分组 6 · 队伍 3"},
      {"value": "6-4", "label": "分组 6 · 队伍 4"},
      {"value": "7-1", "label": "分组 7 · 队伍 1"},
      {"value": "7-2", "label": "分组 7 · 队伍 2"},
      {"value": "7-3", "label": "分组 7 · 队伍 3"},
      {"value": "7-4", "label": "分组 7 · 队伍 4"}
    ]
  },
  {
    "id": "eventType",
    "label": "活动模式",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "活动选择",
    "description": "选择当前开放的版本或限时活动类型",
    "recommended": "tower",
    "options": [
      {"value": "tower", "label": "月度版本活动 · 通用自动爬塔（推荐）"},
      {"value": "uberBoss", "label": "超鬼王 · 自动召唤鬼王与征伐挑战"},
      {"value": "frogQuiz", "label": "对弈竞猜 · 自动领上轮奖励并押注 30 万"},
      {"value": "floatParade", "label": "花车巡游 · 自动领取放置里程与旅途任务"}
    ]
  },
  {
    "id": "rounds",
    "label": "连续挑战局数（爬塔 / 超鬼王）",
    "widget": "SINGLE_CHOICE",
    "required": true,
    "section": "活动选择",
    "description": "单次执行连续挑战多少局",
    "recommended": "20",
    "options": [
      {"value": "10", "label": "10 局"},
      {"value": "20", "label": "20 局（推荐）"},
      {"value": "50", "label": "50 局（清门票/体力）"},
      {"value": "100", "label": "100 局（长挂机）"}
    ]
  },
  {
    "id": "returnHome",
    "label": "完成后返回庭院",
    "widget": "SWITCH",
    "section": "收尾",
    "description": "活动执行结束后是否自动返回庭院",
    "recommended": false
  }
]

=== switch-soul: 自动前往式神录切换御魂预设 ===
[条件] soulPreset != "none"
[超时] 90000ms
[片段] switch-soul-preset

=== run-version-event: 按活动模式执行爬塔、超鬼王、竞猜或花车 ===
[超时] 300000ms

长等待 300秒
按设置 eventType
  "tower"
    按设置 rounds
      "10"
        反复 最多 10 次
          分情况 最多 12秒
            门票用尽 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题
              结果 "今日活动挑战次数已用尽"
              跳出
            奖励弹窗 "获得奖励"@获得奖励标题
              点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
            结算继续 "继续"@结算底部继续 且 没看到 "获得奖励"@获得奖励标题
              点 "继续"@结算底部继续 最多 2秒
            可挑战 "挑战"@右下挑战区 且 没看到 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题 且 没看到 "继续"@结算底部继续
              点 "挑战"@右下挑战区
              用 battle-auto-loop
      "20"
        反复 最多 20 次
          分情况 最多 12秒
            门票用尽 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题
              结果 "今日活动挑战次数已用尽"
              跳出
            奖励弹窗 "获得奖励"@获得奖励标题
              点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
            结算继续 "继续"@结算底部继续 且 没看到 "获得奖励"@获得奖励标题
              点 "继续"@结算底部继续 最多 2秒
            可挑战 "挑战"@右下挑战区 且 没看到 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题 且 没看到 "继续"@结算底部继续
              点 "挑战"@右下挑战区
              用 battle-auto-loop
      "50"
        反复 最多 50 次
          分情况 最多 12秒
            门票用尽 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题
              结果 "今日活动挑战次数已用尽"
              跳出
            奖励弹窗 "获得奖励"@获得奖励标题
              点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
            结算继续 "继续"@结算底部继续 且 没看到 "获得奖励"@获得奖励标题
              点 "继续"@结算底部继续 最多 2秒
            可挑战 "挑战"@右下挑战区 且 没看到 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题 且 没看到 "继续"@结算底部继续
              点 "挑战"@右下挑战区
              用 battle-auto-loop
      "100"
        反复 最多 100 次
          分情况 最多 12秒
            门票用尽 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题
              结果 "今日活动挑战次数已用尽"
              跳出
            奖励弹窗 "获得奖励"@获得奖励标题
              点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
            结算继续 "继续"@结算底部继续 且 没看到 "获得奖励"@获得奖励标题
              点 "继续"@结算底部继续 最多 2秒
            可挑战 "挑战"@右下挑战区 且 没看到 "剩余0次"@中:600,760,600,160 且 没看到 "获得奖励"@获得奖励标题 且 没看到 "继续"@结算底部继续
              点 "挑战"@右下挑战区
              用 battle-auto-loop
  "uberBoss"
    反复 最多 20 次
      分情况 最多 12秒
        疲劳已满 "100/100"@右:1900,0,480,120 且 没看到 "本次伤害"@弹窗正文区
          结果 "超鬼王疲劳度已满，暂停征伐"
          跳出
        伤害结算 "本次伤害"@弹窗正文区
          点 "本次伤害"@弹窗正文区 偏 -30,280 大小 120,80
        召唤鬼王 "召唤"@右下挑战区 且 没看到 "挑战"@右下挑战区 且 没看到 "100/100"@右:1900,0,480,120 且 没看到 "本次伤害"@弹窗正文区
          点 "召唤"@右下挑战区
        开始挑战 "挑战"@右下挑战区 且 没看到 "100/100"@右:1900,0,480,120 且 没看到 "本次伤害"@弹窗正文区
          点 "挑战"@右下挑战区
          用 battle-auto-loop
  "frogQuiz"
    用 enter-town
    如果看到 "对弈竞猜"@中:400,140,1600,560 最多 5秒
      点 "对弈竞猜"@中:400,140,1600,560
    如果看到 "下一局"@弹窗按钮区 最多 4秒
      点 "下一局"@弹窗按钮区
    如果看到 "竞猜"@左:300,380,450,280 最多 4秒
      点 "竞猜"@左:300,380,450,280
      如果看到 "30万"@400,820,1600,160 最多 4秒
        点 "30万"@400,820,1600,160
        点 "竞猜"@右:1600,560,460,260 最多 4秒
        点 "确定"@弹窗确认右侧 最多 4秒
  "floatParade"
    如果看到 "放置里程"@左:0,80,320,240 最多 5秒
      点 "放置里程"@左:0,80,320,240
      如果看到 "领取"@1200,700,700,220 最多 4秒
        点 "领取"@1200,700,700,220
      如果看到 "获得奖励"@获得奖励标题 最多 4秒
        点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
等 "挑战"@右下挑战区 或 "探索"@800,100,700,320 或 "秘卷书童"@中:1180,340,340,120 最多 15秒
结果 "已完成版本与限时活动执行"

=== return-courtyard: 回到庭院 ===
[条件] returnHome = true
[片段] exit-subpage-courtyard
