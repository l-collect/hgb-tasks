    "id": "doDelegation",
    "label": "执行式神委派收获与派发",
    "widget": "SWITCH",
    "section": "式神委派",
    "description": "前往式神委派收获已达成任务，并挑选弥助的画、樱饼配方、猫老大等委派一键出发",
    "recommended": true
  },
  {
    "id": "doHyakkiyakou",
    "label": "执行町中百鬼夜行（每日砸豆完成日常）",
    "widget": "SWITCH",
    "section": "百鬼夜行",
    "description": "前往町中百鬼夜行，自动选鬼王、进入游行连续撒豆收集式神碎片",
    "recommended": false
  },
  {
    "id": "returnHome",
    "label": "全部完成后返回庭院",
    "widget": "SWITCH",
    "section": "收尾",
    "description": "日常活动结束后自动退回庭院",
    "recommended": true
  }
]

=== switch-soul: 自动前往式神录切换御魂预设 ===
[条件] soulPreset != "none"
[超时] 90000ms
[片段] switch-soul-preset

=== demon-four: 逢魔之时（现世逢魔 4 次、逢魔密信自动答题与领达摩） ===
[条件] doDemon = true
[超时] 180000ms

长等待 180秒
去 探索地图
如果看到 "逢魔"@探索底栏 最多 4秒
  点 "逢魔"@探索底栏
否则
  用 enter-town
  如果看到 "逢魔之时"@中:1130,170,150,160 最多 5秒
    点 "逢魔之时"@中:1130,170,150,160
如果看到 "现世逢魔"@右下挑战区 最多 8秒
  反复 最多 12 次
    分情况 最多 8秒
      密信答题 "密信"@中:880,50,640,140
        答题 题@中:880,240,670,155 选@中:875,385,675,115,@中:875,520,675,115,@中:875,655,675,115
        等待 1.5秒
      奖励弹窗 "获得奖励"@获得奖励标题 且 没看到 "密信"@中:880,50,640,140
        点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
      达摩结算 "继续"@结算底部继续 且 没看到 "获得奖励"@获得奖励标题 且 没看到 "密信"@中:880,50,640,140
        点 "继续"@结算底部继续 最多 2秒
      点四次逢魔 "现世逢魔"@右下挑战区 且 没看到 "密信"@中:880,50,640,140 且 没看到 "获得奖励"@获得奖励标题 且 没看到 "继续"@结算底部继续
        点 "现世逢魔"@右下挑战区 最多 4 次 计 现世逢魔四次
        等待 1.2秒
        # 依次点击右侧 4 个逢魔事件灯笼槽位（触发逢魔密信答题或免费开箱）与上方红色达摩领奖
        逐个 灯笼偏Y 在 -120,-230,-320,-420,-540
          如果看到 "现世逢魔"@右下挑战区 最多 3秒
            点 "现世逢魔"@右下挑战区 偏 220,{灯笼偏Y} 大小 70,55 最多 1 次 计 逢魔灯笼{灯笼偏Y}
            等待 1.2秒
            如果看到 "密信"@中:880,50,640,140 最多 3.5秒
              反复 最多 3 次
                如果看到 "密信"@中:880,50,640,140 最多 4秒
                  答题 题@中:880,240,670,155 选@中:875,385,675,115,@中:875,520,675,115,@中:875,655,675,115
                  等待 1.5秒
                否则
                  跳出
              如果看到 "获得奖励"@获得奖励标题 最多 4.5秒
                点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
            否则
              如果看到 "获得奖励"@获得奖励标题 最多 3.5秒
                点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
  等 "现世逢魔"@右下挑战区 最多 12秒
  结果 "已完成 4 次现世逢魔探索、逢魔密信自动答题与达摩领奖"
否则
  结果 "当前不在逢魔之时开放时段（17:00-22:00），已跳过"
等 "现世逢魔"@右下挑战区 或 页 explore 或 "秘卷书童"@中:1180,340,340,120 最多 12秒

=== demon-boss: 逢魔首领集结挑战 ===
[条件] joinDemonBoss = true
[超时] 300000ms

长等待 300秒
如果看到 "现世逢魔"@右下挑战区 最多 4秒
  如果看到 "首领"@逢魔集结入口 最多 6秒
    点 "首领"@逢魔集结入口
    等 "集结"@右下挑战区 最多 8秒
    点 "集结"@右下挑战区
    如果看到 "确定"@弹窗确认右侧 最多 6秒
      点 "确定"@弹窗确认右侧
    用 battle-auto-loop
    结果 "已完成逢魔首领集结战斗"
否则
  去 探索地图
  如果看到 "集结"@左:120,680,260,200 最多 4秒
    点 "集结"@左:120,680,260,200 最多 2秒
  结果 "已检查逢魔首领集结状态"
等 "现世逢魔"@右下挑战区 或 页 explore 或 "秘卷书童"@中:1180,340,340,120 最多 15秒

=== area-boss: 地域鬼王筛选热门并挑战 ===
[条件] doAreaBoss = true
[超时] 240000ms

用 enter-areaboss
长等待 240秒
按设置 areaBossCount
  "1"
    点 "筛选"@地鬼筛选按钮
    等 "热门"@地鬼右侧页签 最多 6秒
    点 "热门"@地鬼右侧页签
    等 "挑战"@地鬼挑战列表 最多 8秒
    点 "挑战"@地鬼挑战列表
    等 "挑战"@右下挑战区 最多 8秒
    点 "挑战"@右下挑战区
    用 battle-auto-loop
  "2"
    反复 最多 2 次
      点 "筛选"@地鬼筛选按钮
      等 "热门"@地鬼右侧页签 最多 6秒
      点 "热门"@地鬼右侧页签
      等 "挑战"@地鬼挑战列表 最多 8秒
      点 "挑战"@地鬼挑战列表
      等 "挑战"@右下挑战区 最多 8秒
      点 "挑战"@右下挑战区
      用 battle-auto-loop
      等 "筛选"@地鬼筛选按钮 最多 15秒
  "3"
    反复 最多 3 次
      点 "筛选"@地鬼筛选按钮
      等 "热门"@地鬼右侧页签 最多 6秒
      点 "热门"@地鬼右侧页签
      等 "挑战"@地鬼挑战列表 最多 8秒
      点 "挑战"@地鬼挑战列表
      等 "挑战"@右下挑战区 最多 8秒
      点 "挑战"@右下挑战区
      用 battle-auto-loop
      等 "筛选"@地鬼筛选按钮 最多 15秒
等 "筛选"@地鬼筛选按钮 最多 15秒
结果 "已完成今日地域鬼王挑战"

=== delegation: 式神委派收获与新任务派发 ===
[条件] doDelegation = true
[超时] 120000ms

用 enter-delegation
反复 最多 4 次
  如果看到 "达成"@委派任务列表 最多 4秒
    点 "达成"@委派任务列表
    等 "完成任务"@弹窗正文区 最多 6秒
    点 "完成任务"@弹窗正文区
    等 "获得奖励"@获得奖励标题 或 "继续"@结算底部继续 最多 8秒
    如果看到 "获得奖励"@获得奖励标题 最多 4.5秒
      点 "获得奖励"@获得奖励标题 偏 -60,555 大小 120,80
    否则
      点 "继续"@结算底部继续
  否则
    跳出
逐个 委派名 在 弥助的画,樱饼配方,猫老大,帮忙搬运
  如果看到 "{委派名}"@委派任务列表 最多 4.5秒
    点 "{委派名}"@委派任务列表
    如果看到 "委派式神"@委派右下按钮 最多 4秒
      点 "委派式神"@委派右下按钮
      等 "一键选择"@委派右下按钮 最多 6秒
      点 "一键选择"@委派右下按钮
      等 "出发"@委派右下按钮 最多 6秒
      点 "出发"@委派右下按钮
      等 "式神委派"@左上标题 最多 8秒
等 "式神委派"@左上标题 最多 8秒
结果 "已完成式神委派收获与派发"

=== hyakkiyakou: 町中百鬼夜行自动撒豆 ===
[条件] doHyakkiyakou = true
[超时] 120000ms

长等待 120秒
用 enter-town
# SM-G9910 实测百鬼夜行灯笼位于 [1575,253,35,86]，以“秘卷书童”偏移 213,-190 直击灯笼中心
点 "秘卷书童"@中:1180,340,340,120 偏 213,-190 大小 60,70
如果看到 "进入"@右下挑战区 最多 6秒
  点 "进入"@右下挑战区
  等 "开始"@右下挑战区 最多 6秒
  点 "开始"@右下挑战区 偏 -700,-240 大小 140,140
  点 "开始"@右下挑战区
  反复 最多 22 次
    如果看到 "继续"@结算底部继续 最多 4.5秒
      点 "继续"@结算底部继续
      跳出
    否则
      # 向游行通道中路连续撒豆
      如果看到 "豆"@左:0,860,960,220 最多 4.5秒
        点 "豆"@左:0,860,960,220 偏 520,-380 大小 260,140 最多 2 次
结果 "已完成百鬼夜行撒豆"
等 "秘卷书童"@中:1180,340,340,120 或 "百鬼夜行"@左上标题 最多 15秒

=== return-courtyard: 回到庭院 ===
[条件] returnHome = true
[片段] exit-subpage-courtyard
